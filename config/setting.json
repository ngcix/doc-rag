{
    "paths": {
        "database_dir": "./data/",
        "documents_dir": "./data/documents/"
    },
    "chunking": {
        "chunk_size": 512,
        "chunk_overlap": 150,
        "separators": [
            "\n\n",
            "\n",
            ". ",
            " ",
            ""
        ],
        "length_function": "len"
    },
    "embedding": {
        "base_url": "http://embedding:80",
        "model_name": "Alibaba-NLP/gte-multilingual-base",
        "model_revision": "9bbca17d9273fd0d03d5725c7a4b0f6b45142062",
        "model_variant": "onnx-o3-fp32",
        "expected_dimension": 768,
        "pooling": "cls",
        "normalize": true,
        "max_sequence_length": 8192,
        "batch_size": 16,
        "connect_timeout_seconds": 2.0,
        "read_timeout_seconds": 30.0,
        "max_retries": 2,
        "max_concurrency": 8
    },
    "vectordb": {
        "backend": "faiss",
        "collection_name": "documents",
        "distance_metric": "cosine",
        "faiss_index_type": "Flat"
    },
    "search": {
        "top_k": 5,
        "score_threshold": 0.3,
        "include_metadata": true
    },
    "sequence_chart": {
        "export_format": "png",
        "export_quality": 150,
        "include_description": true
    },
    "performance": {
        "max_workers": "auto",
        "target_cpu_utilization": 0.8,
        "reserved_cpu_threads": 2
    },
    "image_extraction": {
        "image_format": "png",
        "min_width": 150,
        "min_height": 150,
        "extract_tables": true,
        "extract_figures": true,
        "context_chars": 10000,
        "min_drawing_size": 20
    }
}
