[
  { "id": 1, "ground_truth": "The primary scope is to define the protocols and procedures that realize the distribution of high-quality audio content in mono, stereo, or multi-channel modes." },
  { "id": 2, "ground_truth": "A2DP phụ thuộc vào Generic Access Profile (GAP) và Generic Audio/Video Distribution Profile (GAVDP)." },
  { "id": 3, "ground_truth": "'Advanced audio' refers to high-quality audio distribution, distinguishing it from 'Bluetooth audio', which indicates the distribution of narrow-band voice on SCO channels." },
  { "id": 4, "ground_truth": "SRC (Source) là thiết bị đóng vai trò nguồn phát luồng âm thanh kỹ thuật số, gửi dữ liệu đến thiết bị Sink (SNK) trong cùng piconet." },
  { "id": 5, "ground_truth": "No, the profile does not support synchronized point-to-multipoint distribution." },
  { "id": 6, "ground_truth": "Tốc độ dữ liệu âm thanh nên nhỏ hơn đáng kể so với tốc độ bit khả dụng trên liên kết Bluetooth để cho phép các cơ chế truyền lại hoạt động hiệu quả, giúp giảm thiểu tác động của việc mất gói tin." },
  { "id": 7, "ground_truth": "Content Protection is provided at the application level and is not a function of the Bluetooth link-level security protocol." },
  { "id": 8, "ground_truth": "Thiết bị phải thực hiện truy vấn SDP để lấy phiên bản AVDTP trên thiết bị từ xa trước khi thực hiện quy trình thiết lập kết nối GAVDP." },
  { "id": 9, "ground_truth": "Both the SRC and SNK must be in the STREAMING state to send or receive an audio stream." },
  { "id": 10, "ground_truth": "SBC (Low Complexity Subband Coding) là codec bắt buộc phải được hỗ trợ bởi cả SRC và SNK để đảm bảo khả năng tương tác." },
  { "id": 11, "ground_truth": "The audio data must be transcoded into a mutually supported format, typically the mandatory SBC codec." },
  { "id": 12, "ground_truth": "Đầu ra của bộ giải mã SBC tại SNK phải thỏa mãn ít nhất các tiêu chí 14-bit được định nghĩa trong bộ Conformance Test Suite của SBC." },
  { "id": 13, "ground_truth": "The SBC decoder in the SNK must support sampling frequencies of 44.1 kHz and 48 kHz." },
  { "id": 14, "ground_truth": "Bộ mã hóa SBC tại SRC phải hỗ trợ ít nhất chế độ MONO và một trong các chế độ: DUAL CHANNEL, STEREO hoặc JOINT STEREO." },
  { "id": 15, "ground_truth": "Both the encoder and decoder must support Block Lengths of 4, 8, 12, and 16." },
  { "id": 16, "ground_truth": "Bộ mã hóa SBC tại SRC phải hỗ trợ ít nhất là 8 dải con (subbands)." },
  { "id": 17, "ground_truth": "The LOUDNESS allocation method is mandatory for the SBC encoder in the SRC." },
  { "id": 18, "ground_truth": "Decoder của SNK phải hỗ trợ Minimum Bitpool Value tối thiểu là 2." },
  { "id": 19, "ground_truth": "The maximum available bit rate for mono mode is limited to 320 kb/s." },
  { "id": 20, "ground_truth": "Tốc độ bit tối đa cho phép đối với chế độ hai kênh (two-channel) là 512 kb/s." },
  { "id": 21, "ground_truth": "The Timestamp (TS) is calculated based on the sampling frequency of the encoded audio data. If a packet contains multiple frames, the TS represents the first frame." },
  { "id": 22, "ground_truth": "Nó cho biết số lượng các mảnh (fragments) còn lại, bao gồm cả mảnh hiện tại. Ví dụ: nếu có 3 mảnh, giá trị sẽ lần lượt là 3, 2, 1." },
  { "id": 23, "ground_truth": "The Marker (M) bit must be set to zero." },
  { "id": 24, "ground_truth": "Phải hỗ trợ ít nhất một trong các Layer: Layer I (mp1), Layer II (mp2), hoặc Layer III (mp3)." },
  { "id": 25, "ground_truth": "Yes, support for CRC Protection is mandatory for the SNK." },
  { "id": 26, "ground_truth": "MPF-1 là định dạng tải trọng phương tiện bắt buộc phải hỗ trợ đối với MPEG-1,2 Audio." },
  { "id": 27, "ground_truth": "Yes, support for VBR is mandatory for the decoder in the SNK." },
  { "id": 28, "ground_truth": "MPEG-2 AAC LC (Low Complexity) là Object Type bắt buộc đối với cả SRC và SNK." },
  { "id": 29, "ground_truth": "The new Object Types added are MPEG-4 HE-AAC, HE-AACv2, and AAC-ELDv2." },
  { "id": 30, "ground_truth": "Việc hỗ trợ MPEG-D DRC là tùy chọn (Optional) cho cả SRC và SNK." },
  { "id": 31, "ground_truth": "The SNK must support sampling frequencies of 44.1 kHz and 48 kHz." },
  { "id": 32, "ground_truth": "SNK phải hỗ trợ tất cả các cấu hình kênh lên đến tối đa hai kênh (kênh 1 và kênh 2)." },
  { "id": 33, "ground_truth": "A value of 0 indicates that the bit rate is unknown." },
  { "id": 34, "ground_truth": "Tham số muxConfigPresent phải được đặt thành 1." },
  { "id": 35, "ground_truth": "Sony Corporation should be contacted for license details." },
  { "id": 36, "ground_truth": "Trường Version chứa thông tin về phiên bản cụ thể của họ ATRAC (ví dụ: ATRAC, ATRAC2, hoặc ATRAC3)." },
  { "id": 37, "ground_truth": "It indicates the maximum Sound Unit Length (in bytes) that the SNK decoder can support." },
  { "id": 38, "ground_truth": "16 bit thấp chứa Company ID hợp lệ (non-reserved), và 16 bit cao phải được đặt bằng 0." },
  { "id": 39, "ground_truth": "MPEG-D USAC with MPEG-D DRC is the supported Object Type." },
  { "id": 40, "ground_truth": "Tần số lấy mẫu bắt buộc đối với SNK là 44.1 kHz và 48 kHz." },
  { "id": 41, "ground_truth": "The SRC must support both the Initiator (INT) and Acceptor (ACP) roles." },
  { "id": 42, "ground_truth": "SNK bắt buộc phải hỗ trợ vai trò ACP (Acceptor), vai trò INT là tùy chọn." },
  { "id": 43, "ground_truth": "The SNK acts as the Initiator (INT) to send Delay Reports to the SRC." },
  { "id": 44, "ground_truth": "Dịch vụ cơ bản (Basic service) là bắt buộc phải hỗ trợ." },
  { "id": 45, "ground_truth": "It indicates that the Media Codec Type is not valid." },
  { "id": 46, "ground_truth": "Mã lỗi 0xC3 (INVALID_SAMPLING_FREQUENCY) được sử dụng khi tần số lấy mẫu không hợp lệ hoặc có nhiều giá trị được chọn." },
  { "id": 47, "ground_truth": "It indicates that the requested Channel Mode is not supported by the device." },
  { "id": 48, "ground_truth": "MTU tối thiểu phải hỗ trợ là 335 bytes." },
  { "id": 49, "ground_truth": "Packets DH3, DM3, DH5, and DM5 must be supported." },
  { "id": 50, "ground_truth": "Việc hỗ trợ Inquiry scan là bắt buộc (Mandatory) đối với SNK." },
  { "id": 51, "ground_truth": "The 'Rendering' bit must be set in the Service Class field." },
  { "id": 52, "ground_truth": "Bit 'Capturing' phải được thiết lập trong trường Service Class." },
  { "id": 53, "ground_truth": "Connectable mode is mandatory for both devices." },
  { "id": 54, "ground_truth": "Không, chế độ Non-Connectable bị loại trừ (Excluded) và không được phép sử dụng." },
  { "id": 55, "ground_truth": "Bondable mode is mandatory." },
  { "id": 56, "ground_truth": "Trong chế độ IDLE, SRC bắt buộc phải hỗ trợ khởi tạo 'general inquiry' (truy vấn tổng quát)." },
  { "id": 57, "ground_truth": "The syncword has a fixed 8-bit value of %10011100 or $9C." },
  { "id": 58, "ground_truth": "SBC sử dụng CRC-8 với đa thức tạo G(X) = X8 + X4 + X3 + X2 + 1." },
  { "id": 59, "ground_truth": "The bitpool field is an 8-bit integer." },
  { "id": 60, "ground_truth": "Công thức là: bit_rate = 8 * frame_length * fs / nrof_subbands / nrof_blocks." },
  { "id": 61, "ground_truth": "It means that the corresponding subband has been encoded using joint stereo." },
  { "id": 62, "ground_truth": "SRC (Source) là thiết bị khởi tạo thủ tục Stream Endpoint Discovery." },
  { "id": 63, "ground_truth": "The Start Streaming procedure is used." },
  { "id": 64, "ground_truth": "Thiết bị nhận phải bỏ qua trường đó (xem như giá trị bằng 0) và không được từ chối cấu trúc dữ liệu." },
  { "id": 65, "ground_truth": "The device must ignore and reject any object or message containing a Prohibited value, treating it as erroneous." },
  { "id": 66, "ground_truth": "Lớp Ứng dụng chịu trách nhiệm thích ứng (adapt) dữ liệu âm thanh đã mã hóa vào định dạng gói tin media đã định nghĩa." },
  { "id": 67, "ground_truth": "The Content Protection header may precede the encrypted audio content in the media payload." },
  { "id": 68, "ground_truth": "Có thể thiết lập một hoặc nhiều bit trong mỗi trường để thông báo các khả năng hỗ trợ." },
  { "id": 69, "ground_truth": "Yes, MONO mode is mandatory for the SNK." },
  { "id": 70, "ground_truth": "Là bắt buộc (Mandatory). SNK phải hỗ trợ cả Loudness và SNR." },
  { "id": 71, "ground_truth": "The recommended value is 53." },
  { "id": 72, "ground_truth": "Payload type phải được chọn trong phạm vi động RTP (RTP dynamic range)." },
  { "id": 73, "ground_truth": "The F (Fragmented) bit must be set to 1." },
  { "id": 74, "ground_truth": "Layer I là hỗ trợ có điều kiện (Conditional support), nghĩa là thiết bị phải hỗ trợ ít nhất một trong ba Layer (I, II, III)." },
  { "id": 75, "ground_truth": "The SNK is mandatory to support 44.1kHz." },
  { "id": 76, "ground_truth": "Không, MPEG-D DRC không được hỗ trợ cùng với MPEG-2 AAC LC." },
  { "id": 77, "ground_truth": "No, channels 5.1 and 7.1 are optional." },
  { "id": 78, "ground_truth": "Nó biểu thị loại Bảo vệ nội dung (Content Protection Type) được yêu cầu không được hỗ trợ." },
  { "id": 79, "ground_truth": "It means the Object Type (e.g., AAC LC, HE-AAC) is not supported." },
  { "id": 80, "ground_truth": "Dịch vụ Recovery là tùy chọn (Optional)." },
  { "id": 81, "ground_truth": "Bits corresponding to supported features (e.g., Player, Microphone) are set to 1; others are set to 0." },
  { "id": 82, "ground_truth": "Nếu hỗ trợ 'limited discoverable mode', thì 'non-discoverable mode' là bắt buộc (Mandatory)." },
  { "id": 83, "ground_truth": "'O' stands for Optional, meaning the capability may or may not be supported." },
  { "id": 84, "ground_truth": "'C' (Conditional) nghĩa là hỗ trợ có điều kiện, phụ thuộc vào việc một khả năng khác có được hỗ trợ hay không." },
  { "id": 85, "ground_truth": "'M' stands for Mandatory, meaning the capability must be supported." },
  { "id": 86, "ground_truth": "Không, các khả năng 'Excluded' không bao giờ được kích hoạt khi thiết bị hoạt động trong profile này." },
  { "id": 87, "ground_truth": "The Application layer is responsible for this adaptation." },
  { "id": 88, "ground_truth": "Tốc độ dữ liệu âm thanh nên nhỏ hơn đáng kể so với tốc độ bit khả dụng để dành băng thông cho việc truyền lại gói tin." },
  { "id": 89, "ground_truth": "Delay is caused by radio signal processing, data buffering, and the encoding/decoding process." },
  { "id": 90, "ground_truth": "Lệnh AVDTP_SET_CONFIGURATION_CMD." },
  { "id": 91, "ground_truth": "It indicates the maximum peak bit rate measured per frame." },
  { "id": 92, "ground_truth": "Trường này có độ dài 4 bit." },
  { "id": 93, "ground_truth": "SBC supports a maximum of 8 subbands." },
  { "id": 94, "ground_truth": "Quyết định dựa trên bit 'join[sb]'. Nếu bit này là 1, dải con đó sử dụng joint stereo." },
  { "id": 95, "ground_truth": "Error code 0xD2 (NOT_SUPPORTED_MPF) is returned." },
  { "id": 96, "ground_truth": "Độ dài khung có thể được điều chỉnh bằng cách thay đổi giá trị bitpool." },
  { "id": 97, "ground_truth": "The 'S' (Start) bit is set to 1 for the starting packet of a fragmented SBC frame." },
  { "id": 98, "ground_truth": "'Bluetooth audio' refers to narrow-band voice distribution on SCO channels, unlike A2DP's high-quality audio." },
  { "id": 99, "ground_truth": "MPEG-D DRC can be used with MPEG-4 AAC object types but not with MPEG-2 AAC LC." },
  { "id": 100, "ground_truth": "Giá trị khuyến nghị là 31." }
]
